# Obtain this from Neon or connect Neon to the Vercel project through Storage.
# Server-only secret. Never use a NEXT_PUBLIC_ prefix or commit its real value.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
# Optional fixed origin. Leave unset for Vercel production + preview domains.
# APP_ORIGIN=https://your-app.vercel.app
ALLOW_REGISTRATION=true
